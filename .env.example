# Copy this file to .env and fill in what you need. Never commit .env.
# Empty values are fine: the matching feature is simply switched off.

# ---------- Docker on your computer ----------
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your network too.
MBM_BIND_ADDRESS=127.0.0.1
MBM_WEB_PORT=3000

# ---------- Public settings (written into the build; rebuild after changing) ----------
# Public address of this website (used for Google, sitemap and link previews).
VITE_SITE_URL=https://mbm-technologies.com
# Show buttons to Calibre Exchange (:3001) and Swap (:3030) running on this computer.
# Must be false for the public website.
VITE_SHOW_LOCAL_PORTALS=true
# Public addresses of sister sites, once they exist (leave empty until then).
VITE_CALIBRE_WEBSITE_URL=
VITE_CALIBRE_EXCHANGE_URL=
VITE_CALIBRE_SWAP_URL=
# Company details shown in the footer, contact page and privacy notice.
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_REGISTRATION_NUMBER=
VITE_COMPANY_ADDRESS=
VITE_CONTACT_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_X_URL=
# Cloudflare Turnstile spam check — public site key (pair with TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=

# ---------- Secrets (read when the website runs; never shown on the site) ----------
# Password for the inbox at /admin (at least 12 characters). Empty = inbox off.
ADMIN_PASSWORD=
# Telegram alert when a form is submitted (no personal data is sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile secret key.
TURNSTILE_SECRET_KEY=
# Any long random text, used to scramble IP addresses for spam limits.
RATE_LIMIT_SALT=
